FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.jcloud.txt .
RUN python3 -m pip --default-timeout=120 install --break-system-packages --no-cache-dir -r requirements.jcloud.txt

COPY worker ./worker

CMD ["python3", "-m", "worker.main"]
