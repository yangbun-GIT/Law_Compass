# LawCompass OCI Free Tier production environment template.
# Copy this file to .env on the OCI VM and replace every <...> value on the server only.
# Never commit .env or real secrets.

# Runtime
NODE_ENV=production
APP_NAME=LawCompass
PORT=3000
API_PREFIX=/api/v1

# Public edge. Use :80 for public-IP HTTP testing.
# Use a real domain such as lawcompass.example.com to let Caddy issue HTTPS automatically.
LAWCOMPASS_SITE_ADDRESS=:80
CADDY_ACME_EMAIL=admin@example.com

# Auth and internal trust boundary
JWT_ACCESS_SECRET=<generate-on-server>
JWT_REFRESH_SECRET=<generate-on-server>
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=1209600
INTERNAL_SERVICE_TOKEN=<generate-on-server>
CORS_ORIGINS=
COOKIE_SAME_SITE=lax
REQUEST_TIMEOUT_MS=30000
RETRY_COUNT=1

# Database
POSTGRES_USER=law
POSTGRES_PASSWORD=<generate-on-server>
POSTGRES_DB=lawcompass
DATABASE_URL=postgresql://law:<POSTGRES_PASSWORD>@postgres:5432/lawcompass

# Redis
REDIS_URL=redis://redis:6379
REDIS_STREAM_KEY=video:jobs
REDIS_STREAM_GROUP=video-workers

# OCI single-VM storage. Keep local for the current MVP.
STORAGE_PROVIDER=local
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/app/storage
LOCAL_VIDEO_CACHE_DIR=/app/storage/cache
LOCAL_VIEW_URL_EXPIRES_SEC=900
LOCAL_DOWNLOAD_URL_EXPIRES_SEC=300
MAX_UPLOAD_MB=200

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_APP_DEMO=false
VITE_APP_DEMO_ROUTE=/app-demo/mlkit
VITE_MLKIT_DEMO_MODE=true

# OpenAI / Agent. Keep disabled until a real API key and budget are ready.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SEC=18
ENABLE_OPENAI_ANALYSTS=0
ANALYZE_TIMEOUT_MS=30000

# Worker frame analysis. Keep disabled on Free Tier by default.
WORKER_CONCURRENCY=1
ENABLE_OPENAI_FRAME_ANALYSIS=0
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_FRAME_ANALYSIS_MAX_FRAMES=24
OPENAI_FRAME_ANALYSIS_MAX_OUTPUT_TOKENS=900
OPENAI_FRAME_ANALYSIS_DETAIL=high
OPENAI_FRAME_ANALYSIS_REASONING_EFFORT=minimal
FRAME_ANALYSIS_FIXTURE_MODE=

# YOLO is off by default because model weights are not committed and CPU inference is expensive.
ENABLE_YOLO_FRAME_ANALYSIS=0
YOLO_MODEL_PATH=
YOLO_DEVICE=cpu

# External legal/public APIs. Fill only after separate account/service approval.
LAW_API_OC=
LAW_API_BASE=https://www.law.go.kr/DRF
LAW_API_TARGETS=law,prec
DATA_GO_SERVICE_KEY=
DATA_GO_TRAFFIC_URL=
DATA_GO_SEARCH_YEAR=
DATA_GO_SIDO=
DATA_GO_GUGUN=

# KNIA fault-ratio resources
KNIA_BASE_URL=https://accident.knia.or.kr
KNIA_REQUEST_DELAY_MS=500
KNIA_TIMEOUT_SEC=15
KNIA_COLLECT_MAX_CHARTS=50
KNIA_FAULT_RATIO_JSON_PATH=/app/project_scripts/knia_fault_ratio/knia_fault_ratio_2023_06.codex_review.json
